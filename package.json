{
  "name": "team-playground",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "浏览器端代码片段快速验证 playground · 契约先行，服务端执行可插拔",
  "scripts": {
    "postinstall": "node scripts/sync-pyodide.mjs",
    "sync:pyodide": "node scripts/sync-pyodide.mjs --force",
    "dev": "vite",
    "server": "node scripts/local-server.mjs",
    "check:node": "node scripts/check-node.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "negative": "node scripts/negative.mjs",
    "negative:lua": "node scripts/negative-lua.mjs",
    "negative:sql": "node scripts/negative-sql.mjs",
    "negative:python": "node scripts/negative-python.mjs",
    "negative:go": "node scripts/negative-go.mjs",
    "negative:php": "node scripts/negative-php.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:preview": "npm run build && node scripts/smoke.mjs --preview",
    "smoke:negative": "node scripts/smoke-negative.mjs",
    "smoke:negative:lua": "node scripts/smoke-lua-negative.mjs",
    "smoke:negative:sql": "node scripts/smoke-sql-negative.mjs",
    "smoke:negative:sample": "node scripts/smoke-sample-negative.mjs",
    "smoke:negative:python": "node scripts/smoke-python-negative.mjs",
    "smoke:negative:go": "node scripts/smoke-go-negative.mjs",
    "smoke:negative:php": "node scripts/smoke-php-negative.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "codemirror": "^6.0.2",
    "pyodide": "314.0.7",
    "sql.js": "^1.16.0",
    "typescript": "^5.9.0",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
